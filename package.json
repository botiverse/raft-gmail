{
  "name": "@botiverse/raft-gmail",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Gmail capability service for Raft humans and their authorized agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:cloudflare": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "check": "npm run typecheck && npm test && npm run capability:check && npm run manifest:check",
    "capability:check": "tsx scripts/check-capability-boundary.ts",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/main.ts",
    "dev:web": "vite",
    "deploy:cloudflare": "npm run build:web && wrangler deploy",
    "manifest:check": "tsx scripts/check-manifest.ts",
    "migrate": "tsx scripts/migrate.ts",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test test/**/*.test.*",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cookie-session": "2.1.1",
    "express": "5.2.1",
    "googleapis": "181.0.0",
    "lucide-react": "^1.47.0",
    "pg": "8.23.0",
    "raft-ui": "^0.5.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-session": "2.0.49",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "jsdom": "^27.4.0",
    "playwright": "^1.63.0",
    "supertest": "7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.135.0"
  }
}
